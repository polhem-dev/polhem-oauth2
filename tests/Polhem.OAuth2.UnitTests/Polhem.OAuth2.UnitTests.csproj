<Project Sdk="Microsoft.NET.Sdk">

  <!-- net8.0 runs the core tests against the net8.0 build of the core package. On Windows the tests also run on .NET
       Framework, which loads the netstandard2.0 build of the core package and tests the System.Web package. Other operating
       systems cannot run them, but -p:IncludeNetFrameworkTests=true compiles them. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' Or '$(IncludeNetFrameworkTests)' == 'true'">net8.0;net10.0;net48</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Polhem.OAuth2\Polhem.OAuth2.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\src\Polhem.OAuth2.AspNetCore\Polhem.OAuth2.AspNetCore.csproj" />
    <!-- The settings loader of the samples, whose README promises are tested in SampleConfigTests. -->
    <Compile Include="..\..\samples\Shared\*.cs" LinkBase="Samples" />
    <Compile Remove="AspNetOAuth2ManagerTests.cs;FakeHttpContext.cs" />
  </ItemGroup>

  <!-- The web packages target net10.0 and .NET Framework, so net8.0 runs only the tests of the core package. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="AspNet*.cs;FakeHttpContext.cs;PendingAuthorizationCookieTests.cs;SampleConfigTests.cs;ReadmeDefaultsTests.cs" />
  </ItemGroup>

  <!-- The implicit usings of .NET Framework leave out System.Net.Http. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <ProjectReference Include="..\..\src\Polhem.OAuth2.AspNet\Polhem.OAuth2.AspNet.csproj" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Using Include="System.Net.Http" />
    <Compile Remove="AspNetCore*.cs;SampleConfigTests.cs;ReadmeDefaultsTests.cs" />
  </ItemGroup>

</Project>
