<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Test-only keys for MachineKey.Protect when the System.Web package is tested on .NET Framework. They protect nothing
       outside these tests. -->
  <system.web>
    <machineKey
      validationKey="94D4C42CF78608952EB54CA1D5F2EE1CCB6CCBA6292B8663FB079ACC15274A6090C9698D240900C6F1BCBB836D2669AC50CD4EA7253AE5E71AEC15B0DB4BDA34"
      decryptionKey="6DAD3872129267558232262889CF3F9ACC47E1E9A299F771B61DDCDDC91084A2"
      validation="HMACSHA256"
      decryption="AES" />
    <!-- A domain here is copied into every HttpCookie, which is how a web.config can break a __Host- cookie. The tests
         check that the sign-in cookie names no domain all the same. -->
    <httpCookies domain="app.example.com" />
  </system.web>
</configuration>
