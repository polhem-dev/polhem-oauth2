<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Description>Lightweight OAuth2 sign-in for .NET with Google, Facebook, LINE, Microsoft Entra ID, Auth0 and Okta. Desktop and console applications sign in through the system browser with a loopback redirect and PKCE.</Description>
    <PackageTags>oauth2 pkce loopback desktop google facebook line entra-id azure-ad auth0 okta</PackageTags>
  </PropertyGroup>

  <!-- net8.0 is there so that an application on .NET 8 or 9 gets the handler of SharedHttpClient.Net.cs, which replaces pooled
       connections to follow DNS changes, instead of the netstandard2.0 build, whose handler cannot on those runtimes. -->

  <!-- .NET MAUI applications trim and compile ahead of time on iOS and Android (ADR-006). The trim and AOT analyzers run on
       the .NET targets only, because netstandard2.0 has no trimming annotations. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- System.Text.Json is part of the .NET frameworks, so only the netstandard2.0 build needs the package. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.OAuth2.UnitTests" />
    <InternalsVisibleTo Include="Polhem.OAuth2.DeviceTests" />
  </ItemGroup>

  <!-- A file named *.NetStandard.cs is compiled for netstandard2.0 only, and a file named *.Net.cs for the .NET targets only.
       .NET has the nullable analysis attributes and the HttpContent overloads that take a cancellation token, so only
       netstandard2.0 compiles the internal copies in Polyfills. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="**/*.Net.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Compile Remove="**/*.NetStandard.cs" />
    <Compile Remove="Polyfills/**" />
  </ItemGroup>

</Project>
