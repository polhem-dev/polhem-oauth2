<Project>

  <!-- The package readme is added here rather than in Directory.Build.props, because the SDK adds its default None
       items after that file is imported. Removing and including it again, instead of updating it, also works in the
       outer build of a project with several target frameworks, which is where such a project is packed. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
