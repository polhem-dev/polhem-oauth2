<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The package uses no reflection, and the analyzers keep it that way for applications that trim or compile ahead of time. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>OAuth2 sign-in for ASP.NET Core applications, with Google, Facebook, LINE, Microsoft Entra ID, Auth0 and Okta.</Description>
    <PackageTags>oauth2 pkce aspnetcore google facebook line entra-id azure-ad auth0 okta</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.OAuth2\Polhem.OAuth2.csproj" />
  </ItemGroup>

  <!-- Both web packages compile the files of this folder, so the format of the pending sign-in cookie is defined once. -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.OAuth2.UnitTests" />
  </ItemGroup>

</Project>
