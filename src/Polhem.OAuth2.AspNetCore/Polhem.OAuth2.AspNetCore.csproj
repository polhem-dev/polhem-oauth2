<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>OAuth2 sign-in for ASP.NET Core applications, with Google, Facebook, LINE, Microsoft Entra ID, Auth0 and Okta.</Description>
    <PackageTags>oauth2 openid-connect pkce aspnetcore google facebook line entra-id azure-ad auth0 okta</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.OAuth2\Polhem.OAuth2.csproj" />
  </ItemGroup>

  <!-- Both web packages compile the format of the pending sign-in cookie from this one file. -->
  <ItemGroup>
    <Compile Include="..\Shared\PendingAuthorizationCookie.cs" Link="Shared\PendingAuthorizationCookie.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.OAuth2.UnitTests" />
  </ItemGroup>

</Project>
